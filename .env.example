# Copy this file to .env and fill in real values. .env is gitignored.
# On Railway, set these as service Variables instead of using a .env file.

# --- Telegram ---
BOT_TOKEN=123452345243:Asdfasdfasf
ADMINS=12345678
# Read-only viewers (optional): may DM the bot for /status and /history only,
# no admin commands. Comma-separated Telegram user ids, same format as ADMINS.
VIEWERS=
ip=localhost

# --- ELD anomaly detection ---
QUANTUM_BASE_URL=https://api.quantumeld.com/logger/external
QUANTUM_TOKEN=
GOMOTIVE_BASE_URL=https://api.gomotive.com
GOMOTIVE_TOKEN=
ALERT_CHAT_ID=-1001234567890

# --- Tuning (optional; defaults shown) ---
POLL_INTERVAL=300            # full-sweep interval, seconds
ELD_STALE_THRESHOLD=600      # Quantum report older than this = disconnected
MOVING_SPEED_THRESHOLD=0     # mph above which a vehicle counts as "moving"
TRACK_INTERVAL=120           # disconnected-unit re-check interval, seconds
REMINDER_INTERVAL=600        # re-notify this often while still MOVING + disconnected
STOP_DISPLACEMENT_MI=0.05    # moved less than this between checks = stopped
STOP_SPEED_MPH=1.0           # at/below this speed (or null) = stopped

# --- Database ---
# Unset -> local SQLite at DB_PATH. Set to a Postgres DSN -> PostgreSQL.
# Railway's PostgreSQL plugin injects DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_PATH=db.sqlite3
